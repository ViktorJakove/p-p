go.property("target", msg.url("/player"))

go.property("maxSpeed", 0)
go.property("lag",0)
go.property("maxLag",0)
go.property("lagSpeed",0)
go.property("catchupSpeed",0)

function init(self)
	self.prev = go.get_world_position(self.target)
	self.offset = vmath.vector3()
	self.z = go.get_position().z

	local p = vmath.vector3(self.prev)
	p.z = self.z
	go.set_position(p)
end

function damp(k,dt)
	return 1 - math.exp(-k * dt)
end

function update(self, dt)
	if dt <= 0 then return end

	local pos = go.get_world_position(self.target)
	local vel = (pos-self.prev)/dt
	self.prev = pos

	local speed = vmath.length(vel)

	local desired = vmath.vector3()
	if speed > self.maxSpeed then
		local lag = math.min(self.maxLag, (speed - self.maxSpeed) *self.lag)
		desired = -(vel/speed) * lag
	end

	local growing = vmath.length(desired) > vmath.length(self.offset)
	local k = growing and self.lagSpeed or self.catchupSpeed
	self.offset = self.offset + (desired - self.offset) *damp(k, dt)

	local len = vmath.length(self.offset)
	if len > self.maxLag then
		self.offset = self.offset * (self.maxLag /len)
	end

	
	local cam = pos + self.offset
	cam.z = self.z
	go.set_position(cam)
end
