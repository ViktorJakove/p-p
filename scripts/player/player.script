local fsm = require "scripts.player.fsm"
local state = require "scripts.player.state"

local m_transitions = require "scripts.player.transitions"
local m_run = require "scripts.player.moveset.m_run"
local m_jump = require "scripts.player.moveset.m_jump"
local m_fall = require "scripts.player.moveset.m_fall"
local m_idle = require "scripts.player.moveset.m_idle"
local m_twirl = require "scripts.player.moveset.m_twirl"

local c_idle = require "scripts.player.combat.c_idle"
local c_attack = require "scripts.player.combat.c_attack"
local c_leap = require "scripts.player.combat.c_leap"

go.property("speed", 0)
go.property("jumpTime",0)
go.property("jumpForce", 0)
go.property("gravity", 0)

go.property("twirlForce", 0)
go.property("poundForce", 0)

go.property("speedupTime", 0)
go.property("speedFaster", 0)


function init(self)
	msg.post("#", "acquire_input_focus")

	self.vars = state.new(self)

	self.mov = fsm.new({
		m_idle = m_idle,
		m_run  = m_run,
		m_jump = m_jump,
		m_fall = m_fall,
	}, "m_idle", self.vars, m_transitions)

	self.combat = fsm.new({
		c_idle = c_idle,
		c_attack = c_attack,
		c_leap = c_leap
	}, "c_idle", self.vars)

end

function update(self, dt)

	self.mov:update(dt)
	self.combat:update(dt)
	
	go.set_position(go.get_position() + self.vars.velocity *dt)
end

function on_message(self, message_id, message, sender)

	if message_id == hash("contact_point_response") then
		if message.normal.y > 0.7 then
			self.vars.isGrounded = true
		end
	end

end

function on_input(self, action_id, action)

	local v = self.vars
	
	if action_id == hash("right") then 
		v.dirKeys.right = not action.released
	elseif action_id == hash("left") then
		v.dirKeys.left = not action.released
	end

	v.moveDir = (v.dirKeys.right and 1 or 0) - (v.dirKeys.left and 1 or 0)
	
	self.mov:input(action_id,action)
	self.combat:input(action_id, action)
end
