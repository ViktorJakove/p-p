local fsm = require "scripts.player.fsm"
local state = require "scripts.player.state"

local m_transitions = require "scripts.player.transitions"
local m_run = require "scripts.player.moveset.m_run"
local m_jump = require "scripts.player.moveset.m_jump"
local m_highjump = require "scripts.player.moveset.m_highjump"
local m_fall = require "scripts.player.moveset.m_fall"
local m_idle = require "scripts.player.moveset.m_idle"
local m_twirl = require "scripts.player.moveset.m_twirl"
local m_crouch = require "scripts.player.moveset.m_crouch"
local m_pound = require "scripts.player.moveset.m_pound"
local m_poundfly = require "scripts.player.moveset.m_poundfly"
local m_swim = require "scripts.player.moveset.m_swim"

local c_idle = require "scripts.player.combat.c_idle"
local c_attack = require "scripts.player.combat.c_attack"
local c_leap = require "scripts.player.combat.c_leap"

go.property("speed", 0)
go.property("jumpTime",0)
go.property("jumpForce", 0)
go.property("gravity", 0)
go.property("initFallForce", 0)
go.property("jumpEndPushdown", 0)

go.property("twirlForce", 0)
go.property("twirlTime", 0)
go.property("poundForce", 0)
go.property("poundTime", 0)
go.property("poundFlyDecay", 0)

go.property("speedupTime", 0)
go.property("speed2", 0)

go.property("crouchSpeed", 0)
go.property("highjumpForce", 0)
go.property("highjumpUnlockTime", 0)


function init(self)
	msg.post("#", "acquire_input_focus")

	self.vars = state.new(self)

	self.mov = fsm.new({
		m_idle = m_idle,
		m_run  = m_run,
		m_jump = m_jump,
		m_highjump = m_highjump,
		m_fall = m_fall,
		m_crouch = m_crouch,
		m_twirl = m_twirl,
		m_pound = m_pound,
		m_poundfly = m_poundfly,
		m_swim = m_swim,
	}, "m_idle", self.vars, m_transitions)

	self.combat = fsm.new({
		c_idle = c_idle,
		c_attack = c_attack,
		c_leap = c_leap
	}, "c_idle", self.vars)

	self.correction = vmath.vector3()
end

function update(self, dt)

	self.mov:update(dt)
	self.combat:update(dt)
	
	go.set_position(go.get_position() + self.vars.velocity *dt)

	self.vars.isGrounded = false
	self.correction = vmath.vector3()
end

function on_message(self, message_id, message, sender)
	
	if message_id == hash("contact_point_response") then
		if message.distance > 0 then
			local proj = vmath.project(self.correction, message.normal * message.distance)
			if proj < 1 then
				local comp = (message.distance - message.distance *proj) * message.normal
				go.set_position(go.get_position()+comp)
				self.correction = self.correction + comp
			end
		end
		
		if message.normal.y > 0.7 then
			self.vars.isGrounded = true
			self.vars.twirled = false
			self.vars.pounded = false
			self.vars.keepX = false
		elseif message.normal.y < -0.7 and self.vars.velocity.y > 0 then
			self.vars.velocity.y = 0 --bump
		end
	end

end

function on_input(self, action_id, action)

	--debug
	if not self.mov then return end

	local v = self.vars

	if action_id == hash("down") then v.crouchHeld = not action.released end

	if action_id == hash("up") then v.upHeld = not action.released end
	
	if action_id == hash("right") then 
		v.dirKeys.right = not action.released
	elseif action_id == hash("left") then
		v.dirKeys.left = not action.released
	end

	v.moveDir = (v.dirKeys.right and 1 or 0) - (v.dirKeys.left and 1 or 0)
	
	self.mov:input(action_id,action)
	self.combat:input(action_id, action)
end
